# Nextflow
work/
.nextflow/
.nextflow.log*
results/
logs/
debug-bundles/

# nf-test
.nf-test/
.nf-test.log
tests/results/
nf-test

# nf-core tools (dev-only, installed by bin/setup-dev.sh into /usr/local/bin
# or a venv outside the repo - if one ever ends up here by accident, ignore
# it rather than track it, same as .venv-ui below)
.venv-nfcore/

# nf-core-tools' newer multi-arch/multi-engine container-selection convention
# auto-regenerates these on every `nf-core modules install` - confirmed
# unreferenced anywhere in the actual config chain (Fixed #20, re-confirmed
# 2026-09-13 after they silently reappeared following a later module install
# and got committed by accident) - every module here already handles
# per-engine container selection internally via its own conditional
# `container` line. Ignored, not just periodically deleted, so this can't
# regress a third time.
conf/containers_*.config

# Python
__pycache__/
*.pyc
.venv/
.venv-ui/
.venv-server/
venv/
*.egg-info/

# Streamlit UI runtime artifacts - found missing 2026-09-11 click-testing
# the UI for real: every run writes its own log next to app.py, and every
# uploaded samplesheet lands under assets/uploads/ - neither is source, both
# are per-machine session state.
.streamlit_run.log
.streamlit_run.pid
assets/uploads/

# Secrets / local overrides — never commit real data, credentials, or company-specific config
.env
*.pem
credentials*.json
params/*.local.yaml
params/company.yaml

# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Local-only Claude Code tool permissions (personal, not shared project config)
.claude/settings.local.json
