// Per-process resource defaults. Standard nf-core label convention, matching
// the labels used on the installed nf-core/modules (fastp=process_medium,
// fastqc=process_low, multiqc=process_single). Retry-on-transient-failure
// policy per PLAN.md §6.8 item 9.
//
// Resource requests are automatically clamped to params.max_cpus/max_memory/
// max_time via the native `resourceLimits` directive. (The older nf-core
// check_max() function pattern doesn't parse under Nextflow's strict config
// syntax, default since 26.04 - resourceLimits is the current replacement,
// see https://github.com/nf-core/tools/issues/2923. conf/test.config sets
// max_memory=6.GB for exactly this reason - a fresh WSL2 VM here only had
// 7.5 GB available, well under the naive process_medium default of 36 GB.)

process {
    resourceLimits = [
        cpus:   params.max_cpus   as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time   as nextflow.util.Duration
    ]

    cpus   = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = { 1 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
