// Publishes each tool's outputs to results/<tool>/ - without this, outputs
// stay buried in Nextflow's hashed work directory and nothing ever reaches
// the results/ tree the UI and run.sh both expect to find.

process {
    withName: 'FASTP' {
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BOWTIE2_BUILD' {
        publishDir = [
            path: { "${params.outdir}/bowtie2/index" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BOWTIE2_ALIGN' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/bowtie2/align" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MEGAHIT' {
        publishDir = [
            path: { "${params.outdir}/megahit" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SPADES' {
        // --meta is what makes this metaSPAdes rather than plain SPAdes -
        // the nf-core module has no separate "metaspades" process, only
        // this flag distinguishes the mode (spades.py --meta internally).
        // This pipeline only ever calls SPADES for metagenomic assembly
        // (params.assembler == 'metaspades'), so the flag is unconditional
        // here rather than a runtime param of its own.
        ext.args = '--meta'
        publishDir = [
            path: { "${params.outdir}/metaspades" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'KRAKEN2_KRAKEN2' {
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BRACKEN_BRACKEN' {
        publishDir = [
            path: { "${params.outdir}/bracken" },
            mode: params.publish_dir_mode
        ]
    }
    // Real Krona radial-chart tool-chain (full-UI-architecture Phase 4b, §6.17) - see
    // workflows/microbox.nf's own comment for why these two specific modules. Published
    // under results/kraken2/krona/ (a subdirectory of Kraken2's own results, not a
    // top-level 'krona/' dir) since this chart IS Kraken2's own result, not a separate
    // pipeline stage of its own - matches toolCatalog.ts's real resultDirs entry for
    // 'kraken2' (composer-ui/src/data/toolCatalog.ts), which needed no change to cover
    // this: 'kraken2' already matches anything under 'kraken2/'.
    withName: 'KRAKENTOOLS_KREPORT2KRONA' {
        publishDir = [
            path: { "${params.outdir}/kraken2/krona" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'KRONA_KTIMPORTTEXT' {
        publishDir = [
            path: { "${params.outdir}/kraken2/krona" },
            mode: params.publish_dir_mode
        ]
    }
    // `withName` matches the alias used in the workflow (workflows/
    // microbox.nf's `as KRAKEN2_KRAKEN2_PREDEPLETION` include), not the
    // original module name - needs its own selector, not just reuse of
    // 'KRAKEN2_KRAKEN2' above, or this pass would publish into the exact
    // same results/kraken2/ directory as the post-depletion pass and
    // overwrite/collide with it (same sample meta.id, same filename).
    withName: 'KRAKEN2_KRAKEN2_PREDEPLETION' {
        // Both passes classify the SAME sample (same meta.id), so without
        // this override they'd both emit e.g. "sample1.kraken2.report.txt"
        // - distinct publishDir paths above keep them from overwriting each
        // other on disk, but MultiQC keys its report table by filename-
        // derived sample name and would otherwise show one "sample1" row
        // silently clobbering the other's data instead of two real results.
        ext.prefix = { "${meta.id}_predepletion" }
        publishDir = [
            path: { "${params.outdir}/kraken2_predepletion" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BRACKEN_BRACKEN_PREDEPLETION' {
        // Same MultiQC sample-name collision reasoning as
        // KRAKEN2_KRAKEN2_PREDEPLETION above.
        ext.prefix = { "${meta.id}_predepletion" }
        publishDir = [
            path: { "${params.outdir}/bracken_predepletion" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GENOMAD_ENDTOEND' {
        // --splits: geNomad's own documented remedy for exactly this
        // failure ("If the MMseqs2 search is failing, try to increase the
        // number of splits" - `genomad end-to-end --help`) - found the hard
        // way 2026-09-12, the mmseqs2 marker search against the full
        // genomad_db OOM-killed (SIGKILL) even at a 9GB resourceLimits cap
        // on this 11GB dev VM. Chunking the DB search trades some wall-time
        // for materially lower peak memory, the tool's own intended lever
        // for this - not a workaround bolted on from outside.
        ext.args = '--splits 4'
        publishDir = [
            path: { "${params.outdir}/genomad" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CHECKV_ENDTOEND' {
        publishDir = [
            path: { "${params.outdir}/checkv" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MAXBIN2' {
        // Real measured peak ~200 MiB RAM (docker stats, sampled every 3s
        // against the real ZymoBIOMICS 8-species mock-community assembly +
        // reads, 2026-09-13) - MaxBin2's own internal Bowtie2 coverage step
        // fully used up to 4 threads but never approached the memory a
        // process_medium label would request (36 GB default in
        // conf/base.config). 4 GB is generous headroom over what was
        // actually observed, not a label taken on faith - this project's
        // own standard, same rigor as Kraken2/geNomad needing far MORE than
        // advertised, just the opposite direction this time.
        cpus   = 4
        memory = 4.GB
        publishDir = [
            path: { "${params.outdir}/maxbin2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}
