// publishDir/ext.args/resource overrides for the pathogen/isolate WGS
// sibling pipeline's own processes (workflows/wgs.nf, PLAN.md §6.9) -
// deliberately a separate file from conf/modules.config (the metagenomics
// pipeline's), not appended to it. Included unconditionally from
// nextflow.config; a withName block here with no matching process (i.e.
// whenever params.pipeline=metagenomics) is a harmless no-op.
//
// withName blocks for Mash/seqkit/BLAST+/GATK4 land here one at a time as
// each is actually wired (Phases 3-4), following the same
// "results/wgs/<tool>/" publishDir convention as the metagenomics
// pipeline's "results/<tool>/".

process {
    withName: 'RENAME_REFERENCE' {
        publishDir = [
            path: { "${params.outdir}/wgs/reference" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BWAMEM2_INDEX' {
        publishDir = [
            path: { "${params.outdir}/wgs/bwamem2/index" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BWAMEM2_MEM' {
        // -R (read group): real requirement found while wiring Phase 4, not
        // added speculatively - BWA-MEM2 emits no @RG line at all by
        // default, and GATK4_HAPLOTYPECALLER's GVCF mode (-ERC GVCF) then
        // refuses to run with a genuinely confusing error ("Can only be
        // used in single sample mode currently") because it can't identify
        // a single sample from the BAM without one. Setting ID/SM/LB to the
        // sample id and a fixed Illumina platform (real for this pipeline's
        // short-read WGS use case, per PLAN.md §6.9) fixes it and also
        // means any future multi-sample joint genotyping has real,
        // distinct sample names to key off.
        ext.args = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tLB:${meta.id}\\tPL:ILLUMINA'" }
        // --write-index: makes samtools sort (the module's internal
        // samtools_command when sort_bam=true) also emit a .csi index
        // alongside the sorted BAM, not just the BAM itself - without this,
        // BWAMEM2_MEM's own `csi` output (optional: true) never fires, and
        // SAMTOOLS_STATS below has no index to consume. Real requirement,
        // not a guess: found by reading samtools-stats' own input contract
        // (tuple(meta, input, input_index)) before wiring the two together,
        // same "read the module before assuming" discipline as everywhere
        // else in this repo.
        ext.args2 = '--write-index'
        publishDir = [
            path: { "${params.outdir}/wgs/bwamem2/align" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/wgs/samtools_stats" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'KRAKEN2_KRAKEN2_WGS' {
        // The `as`-aliased process name (workflows/wgs.nf) makes this
        // selector distinct from metagenomics' bare 'KRAKEN2_KRAKEN2' - no
        // collision, same reasoning as conf/modules.config's own
        // KRAKEN2_KRAKEN2_PREDEPLETION selector.
        publishDir = [
            path: { "${params.outdir}/wgs/kraken2" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MASH_SCREEN' {
        // -w (winner-takes-all): mash's own documented flag for exactly
        // this use case (genome/species discovery against a large
        // reference DB) - without it, mash screen emits one row per
        // reference genome that shares ANY hashes at all (tens of thousands
        // of near-zero-identity rows against an unrelated 91,282-genome
        // RefSeq DB), burying the real signal. Verified directly (real
        // ERR044595 reads against the real RefSeq DB, 2026-09-14): with -w,
        // the correct top hit (S. aureus, identity 1.0) is one of a
        // handful of "winning" rows instead of one among tens of thousands.
        ext.args = '-w'
        publishDir = [
            path: { "${params.outdir}/wgs/mash" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SEQKIT_STATS' {
        // NOT ext.args = '--tabular' here - real finding from reading the
        // installed module before assuming (this repo's own discipline):
        // SEQKIT_STATS's script already hardcodes `--tabular` unconditionally
        // and appends task.ext.args on top (defaulting to '--all' if unset).
        // An earlier draft of this plan assumed --tabular needed to be
        // supplied via ext.args - checked and found wrong before writing it,
        // not after a false assumption shipped.
        publishDir = [
            path: { "${params.outdir}/wgs/seqkit_stats" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        publishDir = [
            path: { "${params.outdir}/wgs/gatk4/reference" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            path: { "${params.outdir}/wgs/gatk4/reference" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GATK4_HAPLOTYPECALLER' {
        // -ERC GVCF: always call in GVCF mode, not a plain per-sample VCF -
        // the standard GATK best-practices shape (owner, 2026-09-14: cover
        // the broadest real use case, not just today's single-sample
        // fixture) - costs nothing extra for one sample, makes real
        // cross-sample joint genotyping possible later without recalling.
        ext.args = '-ERC GVCF'
        // ext.prefix: real, serious bug found and fixed while testing this
        // phase, not a defensive guess - both GATK4_HAPLOTYPECALLER and
        // GATK4_GENOTYPEGVCFS default their output to "${meta.id}.vcf.gz".
        // GenotypeGVCFs' own input (this process's GVCF output, staged as a
        // same-named symlink in ITS work dir) and its own output then share
        // one filename - GATK writes through the symlink and genuinely
        // corrupts/empties the original GVCF (observed directly: the real
        // HaplotypeCaller run processed all 20,331 regions across the whole
        // genome per its own log, but the file on disk ended up containing
        // GenotypeGVCFs' own near-empty output instead - a real data-loss
        // bug, not a cosmetic one). Exact same class of bug as this repo's
        // existing KRAKEN2_KRAKEN2_PREDEPLETION fix (conf/modules.config) -
        // same fix shape: a distinct prefix, here using GATK's own
        // conventional ".g.vcf.gz" GVCF naming rather than an arbitrary
        // suffix.
        ext.prefix = { "${meta.id}.g" }
        publishDir = [
            path: { "${params.outdir}/wgs/gatk4/haplotypecaller" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'GATK4_GENOTYPEGVCFS' {
        publishDir = [
            path: { "${params.outdir}/wgs/gatk4/genotypegvcfs" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'WGS:MULTIQC' {
        // withName: 'MULTIQC' alone would also match MICROBOX's own MULTIQC
        // call (conf/modules.config already gives that one its own
        // publishDir under results/multiqc) - the WGS: prefix scopes this
        // to only the WGS workflow's own MultiQC invocation, same
        // disambiguation reasoning as MICROBOX's KRAKEN2_KRAKEN2_PREDEPLETION
        // needing its own selector (conf/modules.config).
        publishDir = [
            path: { "${params.outdir}/wgs/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}
