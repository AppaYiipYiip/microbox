// -profile test: zero-setup smoke test. Points at real, verified nf-core
// test-datasets fixtures (SARS-CoV-2 Illumina reads, the same fixture the
// fastp/fastqc nf-core modules use in their own tests) - confirmed reachable
// (HTTP 200) 2026-09-11, not guessed.

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    input = "${projectDir}/assets/samplesheet_test.csv"

    // Tiny SARS-CoV-2 genome as a stand-in "host" for testing mechanics only
    // (same nf-core/test-datasets fixture the bowtie2 modules use in their
    // own tests) - not biologically meaningful, just proves build+align+
    // filter works before the real host genome is a runtime parameter.
    host_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/genome.fasta'
}

// Declared directly here (not just via params.max_* read from base.config)
// because process.resourceLimits in conf/base.config is evaluated before
// profile-specific param overrides land, so it was still seeing the
// nextflow.config default (128.GB) instead of this profile's 6.GB - found
// by testing on a WSL2 VM with only 7.5 GB actually available.
process {
    resourceLimits = [
        cpus:   2,
        memory: 6.GB,
        time:   6.h
    ]

    // Bracken's default minimum-read threshold (10, at species level) is
    // sensible for real data but impossible to reach with this tiny mechanics
    // fixture (2 reads survive to classification, period) - lowered ONLY for
    // the test profile, production keeps Bracken's real default. Proves the
    // wiring works; says nothing about real accuracy (same distinction
    // PLAN.md §2.3 already draws between mechanics and truth-validation).
    withName: 'BRACKEN_BRACKEN' {
        ext.args = '-t 1'
    }
}
