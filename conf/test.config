// -profile test: zero-setup smoke test. Points at real, verified nf-core
// test-datasets fixtures (SARS-CoV-2 Illumina reads, the same fixture the
// fastp/fastqc nf-core modules use in their own tests) - confirmed reachable
// (HTTP 200) 2026-09-11, not guessed.

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    input = "${projectDir}/assets/samplesheet_test.csv"

    // Lambda phage genome (NC_001416.1, NCBI - a standard, stable, tiny
    // ~48.5kb reference used across bioinformatics as a spike-in/negative
    // control) as a stand-in "host". NOT the SARS-CoV-2 genome the test
    // reads are actually from - that was tried first and was a real bug:
    // it depleted ~98% of reads as "host" (2 of 99 survived), leaving too
    // little data for MEGAHIT to assemble anything (0 contigs) and cascading
    // into QUAST failures no threshold tuning could fix. An unrelated
    // reference is what a host-depletion test should use anyway - it proves
    // "non-host reads pass through unchanged", not "everything gets removed".
    host_fasta = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NC_001416.1&rettype=fasta&retmode=text'
}

// Declared directly here (not just via params.max_* read from base.config)
// because process.resourceLimits in conf/base.config is evaluated before
// profile-specific param overrides land, so it was still seeing the
// nextflow.config default (128.GB) instead of this profile's 6.GB - found
// by testing on a WSL2 VM with only 7.5 GB actually available.
process {
    resourceLimits = [
        cpus:   2,
        memory: 6.GB,
        time:   6.h
    ]

    // Bracken's default minimum-read threshold (10, at species level) is
    // sensible for real data but impossible to reach with this tiny mechanics
    // fixture (2 reads survive to classification, period) - lowered ONLY for
    // the test profile, production keeps Bracken's real default. Proves the
    // wiring works; says nothing about real accuracy (same distinction
    // PLAN.md §2.3 already draws between mechanics and truth-validation).
    withName: 'BRACKEN_BRACKEN' {
        ext.args = '-t 1'
    }

    // Same story as Bracken above: QUAST's default --min-contig 500 is a
    // sensible real-data default, but this tiny fixture's MEGAHIT assembly
    // produces nothing that long. Test-profile-only.
    withName: 'QUAST' {
        ext.args = '--min-contig 1'
    }

    // geNomad's mmseqs2 marker search needs more than the profile-wide 6GB
    // ceiling above to load its DB even with --splits (conf/modules.config)
    // applied - found the hard way 2026-09-12 (SIGKILL under the general
    // cap). A `withName` block can override `resourceLimits` itself, not
    // just `memory`, so this raises the ceiling ONLY for this one process
    // rather than the whole profile - the general 6GB cap above exists
    // specifically to keep `-profile test` usable on the weakest known dev
    // machine (~7.5GB total, PLAN.md §1.1), and geNomad's own real
    // requirement shouldn't erode that guarantee for every other process.
    withName: 'GENOMAD_ENDTOEND' {
        resourceLimits = [
            cpus:   6,
            memory: 9.GB,
            time:   6.h
        ]
    }
}
