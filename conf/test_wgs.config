// -profile test_wgs: smoke test for the WGS sibling pipeline (PLAN.md §6.9),
// for direct manual runs - e.g. `bin/run.sh --pipeline wgs -profile
// test_wgs,docker` - not what tests/main.nf.test itself uses (that shared
// test file runs everything under one --profile test,docker invocation and
// overrides pipeline/input directly per-test, this suite's existing
// convention - see its own "pipeline=wgs" test section, which uses this
// same fixture for its positive BWA-MEM2 test).
//
// Real biological data, not a mechanics stand-in - corrected 2026-09-14
// after an earlier version of this file wrongly dismissed nf-core/bacass's
// own real test fixture as "too large" based on file size alone (~115MB
// total for R1+R2), without actually testing it. Measured instead: it
// downloads in ~19s and BWA-MEM2 aligns all 1M read pairs against the real
// matching reference in ~20-23s on a 2cpu/6GB ceiling - comparable to or
// faster than several other tests already in this suite. ERR044595 is real
// ENA-cataloged Staphylococcus aureus sequencing data (confirmed via ENA's
// portal API); NC_007795.1 (S. aureus NCTC 8325) is its matching reference -
// a real run maps ~90.7% of reads, confirming this is genuinely the right
// organism pairing, not just a plausible-looking file. A real fixture with
// a known expected variant (for Phase 4's GATK4 test specifically) is still
// a separate open item - see docs/KNOWN_ISSUES.md.

params {
    config_profile_name        = 'WGS test profile'
    config_profile_description = 'Real Staphylococcus aureus test dataset (ERR044595) to check the WGS sibling pipeline'

    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    pipeline            = 'wgs'
    input               = "${projectDir}/assets/samplesheet_wgs_test.csv"
    skip_bwamem2        = false
    wgs_reference_fasta = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NC_007795.1&rettype=fasta&retmode=text'
}

process {
    resourceLimits = [
        cpus:   2,
        memory: 6.GB,
        time:   6.h
    ]
}
