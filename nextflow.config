manifest {
    name            = 'AppaYiipYiip/microbox'
    author          = 'marouane'
    homePage        = 'https://github.com/AppaYiipYiip/microbox'
    description     = 'Modular, GUI-agnostic metagenomics pipeline toolbox'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0'
}

params {
    // Which sibling pipeline runs (PLAN.md §6.9, promoted to a requirement
    // 2026-09-14) - 'metagenomics' (default, workflows/microbox.nf) or 'wgs'
    // (pathogen/isolate whole-genome sequencing, workflows/wgs.nf). See
    // main.nf for the branching this drives.
    pipeline   = 'metagenomics' // 'metagenomics' | 'wgs'
    input      = null
    input_type = 'fastq' // 'fastq' | 'contigs' - PLAN.md §6.7 multiple entry points (pipeline=metagenomics only)
    outdir     = 'results'

    // ---- pipeline=wgs only (PLAN.md §6.9) ------------------------------
    // Real tool params land here as each stage is actually wired, one at a
    // time - not pre-declared before the module that reads it exists yet,
    // matching this repo's own discipline (CONTRIBUTING.md §1).

    // Phase 2: reference-guided alignment (BWA-MEM2, GATK best-practices
    // aligner for variant calling - PLAN.md §6.9's own tool choice) +
    // samtools stats for real MultiQC content. Off by default per this
    // repo's established pattern for every prior optional tool (MaxBin2/
    // geNomad/CheckV) - the owner asked for WGS modules to default ON, but
    // PLAN.md §6.9 flags that decision as still open pending real
    // docker-stats measurement against the ~7GB dev RAM ceiling; kept off
    // here until that measurement happens (see docs/KNOWN_ISSUES.md).
    // One reference serves every sample/row in a WGS run (isolates of the
    // same organism vs. one reference, not a different reference per row -
    // assets/schema_input_wgs.json), so this is a single pipeline-wide path,
    // not a per-row samplesheet column.
    skip_bwamem2        = true
    wgs_reference_fasta = null

    // Phase 3: pre-flight species/contamination screening, on raw reads,
    // before alignment - both stages independently toggleable, not a forced
    // either/or (owner, 2026-09-14: "keep both, allow the user to pick
    // whatever they want, as long as they are both functional"). Researched
    // first (owner: "google to make sure we would be providing something
    // useful"): real bacterial WGS QC pipelines (nf-core/bacass, general
    // practice) most commonly use Kraken2 as the primary species/
    // contamination gate; Mash Screen is also real and used in the field
    // (public health plasmid-transmission surveillance), just for a
    // different specific signal (fast genome-distance estimation) - both
    // are genuinely useful, for different reasons, so both are wired.
    //
    // Kraken2 reuses the exact same module and DB as the metagenomics
    // pipeline (params.kraken2_db below, unrelated to pipeline=wgs) via an
    // `as`-aliased include in workflows/wgs.nf - same tool, same job
    // (classify reads), just a different pipeline context, not a second
    // copy. Off by default - DB-dependent, same reasoning as every other
    // DB-dependent tool in this repo.
    skip_kraken2_wgs = true

    // Mash Screen against a real external RefSeq sketch database (NOT a
    // self-sketch of wgs_reference_fasta - a self-sketch would only
    // re-confirm what BWA-MEM2's own mapping rate already shows; the
    // external DB is what makes this a genuine, independent contamination/
    // species-ID check). Real, official DB verified reachable 2026-09-14:
    // https://gembox.cbcb.umd.edu/mash/refseq.genomes.k21s1000.msh (~754MB)
    // - see bin/download-dbs.sh's `mash_refseq` variant. Off by default,
    // same DB-dependent reasoning as Kraken2 above.
    skip_mash      = true
    mash_refseq_db = null

    // Read-count/length/quality summary stats on raw reads - no DB needed,
    // but kept off by default for consistency with this phase's other two
    // stages rather than special-cased on. NOT `ext.args = '--tabular'`
    // (conf/modules_wgs.config) - correction, 2026-09-14: the installed
    // SEQKIT_STATS module already hardcodes --tabular unconditionally in
    // its own script; an earlier draft of this comment assumed it needed
    // supplying, based on MultiQC's docs describing the requirement in the
    // abstract, without having read the actual installed module first.
    skip_seqkit_stats = true

    // Phase 4: variant calling (GATK4 HaplotypeCaller - the GATK best-
    // practices/field-standard caller, PLAN.md §6.9's own tool choice).
    // Always calls in GVCF mode (-ERC GVCF, conf/modules_wgs.config) then
    // genotypes per-sample via GenotypeGVCFs - the standard GATK
    // best-practices shape, not an arbitrary choice: it costs nothing extra
    // for a single sample today, and makes real cross-sample joint
    // genotyping straightforward to add later without recalling anything,
    // which matters here specifically because this pipeline's own stated
    // scenario is "many isolates of the same organism vs. one reference"
    // (owner, 2026-09-14: cover the broadest real use case, don't leave a
    // gap the GUI would hit later). True cross-sample combining
    // (gatk4/genomicsdbimport or combinegvcfs across N samples) is
    // deliberately NOT built yet - it needs a second real isolate fixture
    // to build and test against honestly, not left as an unverified
    // abstraction; recorded as a real follow-on, not silently dropped.
    // Needs skip_bwamem2=false (consumes its BAM) - auto-skips with a
    // warning otherwise (workflows/wgs.nf), same "warn, don't crash"
    // pattern as every inapplicable-combination guard in this repo.
    // DeepVariant/FreeBayes remain unimplemented enum values
    // (params.variant_caller) - not built until a real requirement calls
    // for them, matching this repo's own precedent of not pre-building.
    skip_gatk4      = true
    variant_caller  = 'gatk4' // 'gatk4' | 'deepvariant' | 'freebayes' - only gatk4 implemented

    // Read QC/trim - independently skippable (added 2026-09-11, toolbox
    // combinatorics sweep found these had no skip_* flag at all, contrary
    // to PLAN.md §6.7's "any element optional" principle). Skipping fastp
    // just means FastQC/host-depletion/assembly run on the raw reads
    // instead of trimmed ones - a legitimate, if unusual, pipeline shape.
    skip_fastp  = false
    skip_fastqc = false

    // Host depletion (PLAN.md §6.7: optional stage; §6.1: host genome is
    // always a runtime parameter, never bundled - species is unknown/varies).
    skip_host_removal = false
    host_fasta        = null

    // Assembly - independently skippable (added 2026-09-11, same
    // combinatorics-sweep finding as skip_fastp/skip_fastqc above). QUAST
    // auto-skips itself when this is on (workflows/microbox.nf) since it
    // would otherwise have no contigs to QC.
    skip_megahit = false

    // Which assembler runs assembly, when it runs at all (added 2026-09-12,
    // PLAN.md §6.6 item 1 - "MEGAHIT/metaSPAdes selection are runtime
    // params with sane defaults" was explicitly anticipated but never
    // wired up). 'megahit' (default: fast, low memory, this pipeline's
    // original assembler) or 'metaspades' (SPAdes --meta mode: typically
    // more contiguous/accurate assemblies, at real cost - much more time
    // and memory; PLAN.md §9 tool catalogue).
    assembler = 'megahit' // 'megahit' | 'metaspades'

    // Taxonomic classification. Off by default - the DB is a whole directory
    // that needs `bin/download-dbs.sh` run first, not something any profile
    // can fetch on its own the way the FASTQ/host-genome fixtures do.
    // Classifies the DEPLETED reads (fastq entry, after host removal) or the
    // contigs file (contigs entry) - see skip_kraken2_predepletion below for
    // the separate, independent classification of reads BEFORE depletion.
    skip_kraken2 = true
    kraken2_db   = null

    // A SECOND, independent Kraken2 classification pass - added 2026-09-13
    // at the owner's request, matching their R&D team's real reference
    // pipeline: classify reads right after trimming/QC, in ADDITION to (not
    // instead of) skip_kraken2's existing post-depletion classification
    // above. Lets a run see the full community composition including host
    // DNA (this pass) alongside the purely-microbial picture (the existing
    // pass) - two genuinely different, both useful results, not a
    // duplicate. fastq entry point only (there are no "pre-depletion reads"
    // on the contigs entry point - workflows/microbox.nf guards this the
    // same way skip_host_removal is inapplicable there). Same DB as
    // skip_kraken2 (kraken2_db above) - one DB serves both passes.
    skip_kraken2_predepletion = true

    // Abundance re-estimation from Kraken2's report - same DB, no separate
    // download. Independently skippable, but meaningless without Kraken2.
    // Applies to BOTH classification passes above when they're enabled -
    // one flag, since there's no reason to want re-estimation for one pass
    // but not the other.
    skip_bracken = false

    // Viral/plasmid discovery (geNomad) + quality assessment of what it
    // finds (CheckV) - added 2026-09-12, PLAN.md §9 tool catalogue. Off by
    // default, same reasoning as Kraken2: both need their own separate DB
    // directory (`bin/download-dbs.sh genomad` / `checkv`), not something
    // the zero-setup test profile can fetch on its own. Works on contigs
    // only (any entry point/assembler) - skip_checkv has no effect when
    // skip_genomad is on, matching skip_bracken's relationship to Kraken2.
    skip_genomad = true
    genomad_db   = null
    skip_checkv  = true
    checkv_db    = null

    // Genome binning (MaxBin2) - added 2026-09-13, PLAN.md §4/Phase 4b:
    // "optional binning stage after assembly". Off by default, but unlike
    // Kraken2/geNomad/CheckV this isn't because of a DB-download cost (no
    // external DB needed at all) - it's genuinely optional by design
    // (PLAN.md's own framing), same as those tools' "not part of the core
    // MVP path" reasoning. Only meaningful on the fastq entry point with
    // assembly enabled (needs both contigs and the reads they came from) -
    // see workflows/microbox.nf's guard.
    skip_maxbin2 = true

    // Assembly QC - no external DB/reference needed, so on by default.
    skip_quast = false

    publish_dir_mode = 'copy'

    // Defaults, clamped against per-process resource requests via the
    // `resourceLimits` directive (conf/base.config, conf/test.config).
    // Environment profiles override these downward as appropriate.
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'
}

// Work dir MUST be off the Windows-mounted filesystem (/mnt/c/... under
// WSL2), not just for performance (PLAN.md §2.3's original reasoning) but
// for correctness: it doesn't support Unix named pipes, and MEGAHIT (and
// likely other tools) rely on os.mkfifo() internally - confirmed via a real
// failure (`OSError: [Errno 95] Operation not supported`), not a guess.
// Portable across machines/users - no hardcoded username.
workDir = "${System.getProperty('user.home')}/nf-work"

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
// WGS sibling pipeline's own module config (PLAN.md §6.9) - kept separate
// from conf/modules.config rather than appended, so WGS-specific ext.args/
// resource overrides don't accumulate in the metagenomics file. Included
// unconditionally: a withName block with no matching process (i.e. every
// block here, when pipeline=metagenomics) is a harmless no-op, not a cost.
includeConfig 'conf/modules_wgs.config'

// FAIR provenance, always on (PLAN.md §7.2/§6.7 - not opt-in CLI flags,
// since a run made without remembering -with-trace has an incomplete
// record). Fixed filenames, overwritten each run - the uniquely-timestamped
// artifact per run is results/run-report/run_<ts>.md (main.nf); these three
// are the latest run's technical drill-down, not a historical archive of
// every run (config-file strict syntax doesn't allow a shared `def`
// timestamp variable here the way main.nf's workflow block does).
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
// Pipeline DAG - always on, same "not opt-in" reasoning as trace/report/
// timeline above (added 2026-09-11: PLAN.md §6.2 already lists -with-dag
// in the debugging toolkit, but it was never actually enabled by default).
// Galaxy/Snakemake both treat a workflow-topology diagram as a standard
// part of "what ran" (researched 2026-09-11); Nextflow's own .html output
// renders a self-contained Mermaid diagram - no Graphviz or other system
// dependency needed, consistent with every other report here being a
// single portable file.
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        docker.temp         = 'auto'
        conda.enabled       = false
        singularity.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_wgs {
        includeConfig 'conf/test_wgs.config'
    }
    // dev / prod profiles land in later milestones once the capped-vs-full
    // Kraken2 DB stages exist (PLAN.md §2.3, §6.3). No separate "test_aws"
    // tier - production is one normal Windows EC2 VM (PLAN.md §7), not a
    // distinct AWS-only environment (owner, 2026-09-13).
}
