manifest {
    name            = 'microbox'
    author          = 'marouane'
    homePage        = 'https://github.com/AppaYiipYiip/microbox'
    description     = 'Modular, GUI-agnostic metagenomics pipeline toolbox'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0'
}

params {
    input      = null
    outdir     = 'results'

    // Host depletion (PLAN.md §6.7: optional stage; §6.1: host genome is
    // always a runtime parameter, never bundled - species is unknown/varies).
    skip_host_removal = false
    host_fasta        = null

    publish_dir_mode = 'copy'

    // Defaults, clamped against per-process resource requests via the
    // `resourceLimits` directive (conf/base.config, conf/test.config).
    // Environment profiles override these downward as appropriate.
    max_memory = '128.GB'
    max_cpus   = 16
    max_time   = '240.h'
}

// Work dir MUST be off the Windows-mounted filesystem (/mnt/c/... under
// WSL2), not just for performance (PLAN.md §2.3's original reasoning) but
// for correctness: it doesn't support Unix named pipes, and MEGAHIT (and
// likely other tools) rely on os.mkfifo() internally - confirmed via a real
// failure (`OSError: [Errno 95] Operation not supported`), not a guess.
// Portable across machines/users - no hardcoded username.
workDir = "${System.getProperty('user.home')}/nf-work"

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// FAIR provenance, always on (PLAN.md §7.2/§6.7 - not opt-in CLI flags,
// since a run made without remembering -with-trace has an incomplete
// record). Fixed filenames, overwritten each run - the uniquely-timestamped
// artifact per run is results/run-report/run_<ts>.md (main.nf); these three
// are the latest run's technical drill-down, not a historical archive of
// every run (config-file strict syntax doesn't allow a shared `def`
// timestamp variable here the way main.nf's workflow block does).
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        docker.temp         = 'auto'
        conda.enabled       = false
        singularity.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    // dev / test_aws / prod profiles land in later milestones once the
    // capped-vs-full Kraken2 DB stages exist (PLAN.md §2.3, §6.3).
}
