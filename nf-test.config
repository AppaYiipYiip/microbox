config {

    testsDir "tests"
    // MUST be off the Windows-mounted filesystem (/mnt/c/... under WSL2) -
    // nf-test manages its own work dir independent of the pipeline's own
    // `workDir` setting in nextflow.config, and defaults to inside the repo
    // (on /mnt/c). Same mkfifo/correctness issue as docs/KNOWN_ISSUES.md #9
    // (MEGAHIT), caught for the second time by this test suite itself.
    workDir System.getenv('HOME') + "/nf-test-work"
    configFile "tests/nextflow.config"
    profile ""

}
