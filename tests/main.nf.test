nextflow_pipeline {

    name "microbox pipeline"
    script "main.nf"

    // outdir MUST be nf-test's own $outputDir variable, not a hand-picked
    // path - nf-test isolates every test run into its own temp directory
    // tree, and a relative path written into params.outdir doesn't land
    // where a `path(...)` assertion looks for it (found the hard way: every
    // test failed on this before the fix, even though the pipeline itself
    // ran successfully).

    // ============================================================
    // input_type=fastq (default entry point) - zero external setup
    // ============================================================
    // tag "basic": nf-test test --tag basic

    test("fastq: defaults - full pipeline runs end to end") {
        tag "basic"

        when {
            params { outdir = "$outputDir" }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
            assert path("${outputDir}/fastp/test_R1.fastp.fastq.gz").exists()
            assert path("${outputDir}/bowtie2/align").exists()
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
            assert path("${outputDir}/quast/test.tsv").exists()
            // Checks QUAST data actually reached the MultiQC *report content*,
            // not just that quast/test.tsv exists on disk as a side output -
            // these are NOT the same thing (found the hard way: QUAST's
            // renamed test.tsv symlink isn't what MultiQC's QUAST module
            // recognizes; only QUAST.out.results/report.tsv is - see
            // workflows/microbox.nf and docs/KNOWN_ISSUES.md).
            assert path("${outputDir}/multiqc/multiqc_data/multiqc_general_stats.txt").text.contains("quast")
            // MultiQC has a native MEGAHIT module (content-sniffs any file
            // for a " - MEGAHIT v" header, no special filename needed) -
            // wired in 2026-09-11 after the owner asked whether "no matter
            // what the last node is, we get a report" actually held.
            // Verify MEGAHIT's own log genuinely reached MultiQC, not just
            // that megahit/test.log exists on disk untouched.
            assert path("${outputDir}/multiqc/multiqc_data/multiqc_general_stats.txt").text.toLowerCase().contains("megahit")
            // Kraken2/Bracken are opt-in (skip_kraken2 defaults true) - the
            // default run must NOT produce them, proving the skip flag
            // actually skips, not just defaults to "off" in name only.
            assert !path("${outputDir}/kraken2").exists()
            assert !path("${outputDir}/bracken").exists()
            // FAIR provenance record (PLAN.md §6.2/§7.2, crucial requirement)
            // must exist on every run, not just successful ones tested by hand.
            assert path("${outputDir}/run-report").list().size() > 0
            // Tool-version provenance (added 2026-09-11, Galaxy/nf-core norm
            // researched the same day: PLAN.md §7.2 promised "tool versions"
            // as part of FAIR compliance, but nothing ever collected them -
            // every module already emitted to the `versions` topic channel,
            // nothing subscribed to it). Both outputs must exist and name at
            // least the tools this exact test run used.
            assert path("${outputDir}/pipeline_info/software_versions.yml").text.contains("fastp")
            assert path("${outputDir}/pipeline_info/software_versions_mqc.yml").text.contains("megahit")
            // Pipeline DAG - enabled by default 2026-09-11 (was listed in
            // PLAN.md §6.2's debugging toolkit but never actually switched
            // on; Galaxy/Snakemake both treat a topology diagram as a
            // standard part of "what ran").
            assert path("${outputDir}/pipeline_info/pipeline_dag.html").exists()
        }
    }

    test("fastq: assembler=metaspades runs SPAdes --meta instead of MEGAHIT, QUAST/versions follow it") {
        tag "basic"

        when {
            params {
                outdir    = "$outputDir"
                assembler = "metaspades"
            }
        }

        then {
            assert workflow.success
            // MEGAHIT must NOT have run - proves this is a genuine either/or
            // choice, not "metaspades" quietly doing nothing and the default
            // assembler running anyway.
            assert !path("${outputDir}/megahit").exists()
            assert path("${outputDir}/metaspades/test.contigs.fa.gz").exists()
            // QUAST works on whichever assembler actually produced contigs -
            // same contigs-quality reporting either way, verified directly
            // rather than assumed (2026-09-12: real ZymoBIOMICS data already
            // confirmed the same principle at production scale, see
            // docs/KNOWN_ISSUES.md).
            assert path("${outputDir}/quast/test.tsv").exists()
            assert path("${outputDir}/multiqc/multiqc_data/multiqc_general_stats.txt").text.contains("quast")
            // MultiQC has NO native SPAdes/metaSPAdes module (verified
            // 2026-09-12 against the full assembly-tool module list) -
            // unlike MEGAHIT's log above, nothing sniffs test.spades.log for
            // report content, so deliberately not asserting anything about
            // it appearing in the MultiQC report. QUAST is what actually
            // covers "any node can be last and still get a report" here.
            assert path("${outputDir}/pipeline_info/software_versions.yml").text.contains("spades")
        }
    }

    test("fastq: skip_host_removal=true skips Bowtie2, assembly still runs on undepleted reads") {
        tag "basic"

        when {
            params {
                outdir            = "$outputDir"
                skip_host_removal = true
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
        }
    }

    test("fastq: skip_quast=true skips assembly QC, assembly itself still runs") {
        tag "basic"

        when {
            params {
                outdir     = "$outputDir"
                skip_quast = true
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/quast").exists()
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
        }
    }

    test("fastq: skip_host_removal AND skip_quast together - independent flags don't interfere") {
        tag "basic"

        when {
            params {
                outdir            = "$outputDir"
                skip_host_removal = true
                skip_quast        = true
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/bowtie2").exists()
            assert !path("${outputDir}/quast").exists()
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }

    // ============================================================
    // fastp/FastQC/MEGAHIT independently skippable - added 2026-09-11.
    // Before this, these three had NO skip_* flag at all and always ran
    // unconditionally on the fastq entry point, which both undercounted the
    // pipeline's real combinatorial space (owner: "with 6 unique tools I'd
    // expect more than 16 tests") and meant the fastq entry point could
    // never legitimately end on anything but Kraken2/QUAST. Recomputed
    // combinatorics with these three now genuinely independent: 72 distinct
    // behavioral configurations on the fastq entry point alone (2 fastp ×
    // 2 fastqc × 2 host_removal × 3 effective megahit/quast joint states ×
    // 3 effective kraken2/bracken joint states) + 4 on contigs = 76 total.
    // Addendum, 2026-09-13: skip_kraken2_predepletion adds a further
    // genuinely independent toggle (its own separate Kraken2/Bracken pass,
    // see the "pre-depletion classification" tests below) - the count above
    // predates it and is not recomputed here; see docs/KNOWN_ISSUES.md's
    // 2026-09-13 entry for that feature's own rationale and test coverage.
    // Not exhaustively tested one-by-one here (76 full-pipeline Docker runs
    // would be redundant given how orthogonal these flags are, and no
    // major bioinformatics test suite - nf-core, Galaxy - does exhaustive
    // combinatorial testing either); tested instead with the standard
    // pairwise/boundary approach: every flag toggled independently at least
    // once, every cascading interaction the code actually implements
    // exercised at least once, matching the density already established
    // for skip_kraken2/skip_bracken above.
    // ============================================================

    test("fastq: skip_fastp=true - FastQC/host-depletion/assembly run on RAW reads, not trimmed") {
        tag "basic"

        when {
            params {
                outdir     = "$outputDir"
                skip_fastp = true
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/fastp").exists()
            assert path("${outputDir}/fastqc").exists()
            assert path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }

    test("fastq: skip_fastqc=true - everything else runs unaffected") {
        tag "basic"

        when {
            params {
                outdir      = "$outputDir"
                skip_fastqc = true
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/fastp").exists()
            assert !path("${outputDir}/fastqc").exists()
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
        }
    }

    test("fastq: skip_megahit=true - QUAST auto-skips too (nothing to QC), rest of the pipeline unaffected") {
        tag "basic"

        // The cascading half of the new flag: QUAST needs contigs, and
        // skip_megahit=true means none exist. workflows/microbox.nf catches
        // this with a log.warn + automatic skip, not a hard failure or a
        // silent run against an empty channel - same "inapplicable
        // combination made to not-happen automatically" pattern already
        // used for skip_host_removal-on-contigs and Bracken-on-contigs.
        when {
            params {
                outdir       = "$outputDir"
                skip_megahit = true
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/megahit").exists()
            assert !path("${outputDir}/quast").exists()
            assert path("${outputDir}/fastp").exists()
            assert path("${outputDir}/fastqc").exists()
            assert path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }

    test("fastq: skip_megahit=true with skip_quast=false explicitly - still auto-skips, doesn't crash on the contradiction") {
        tag "basic"

        // Same guard as above, but proves it holds even when the caller
        // explicitly asks for QUAST rather than relying on its default -
        // the auto-skip must win either way, not just when skip_quast was
        // left at its default.
        when {
            params {
                outdir       = "$outputDir"
                skip_megahit = true
                skip_quast   = false
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/quast").exists()
        }
    }

    test("fastq: everything optional off - fails with the same clear message as the contigs degenerate case, not a MultiQC crash") {
        tag "basic"

        // The fastq-entry mirror of the existing contigs "nothing enabled"
        // test below - only reachable at all once fastp/FastQC/MEGAHIT
        // became independently skippable (2026-09-11). Proves the guard in
        // workflows/microbox.nf covers both entry points, not just contigs.
        when {
            params {
                outdir             = "$outputDir"
                skip_fastp         = true
                skip_fastqc        = true
                skip_host_removal  = true
                skip_megahit       = true
                skip_kraken2       = true
                skip_quast         = true
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.toString().contains("Nothing enabled to analyze or report")
        }
    }

    test("fastq: everything except Kraken2 off - the fastq-entry equivalent of the contigs single-node case") {
        tag "requires_db"

        // Mirrors "contigs: Kraken2 alone" below, but for the fastq entry
        // point: fastp/FastQC/host-depletion/MEGAHIT/QUAST all off, only
        // Kraken2 (classifying the raw, undepleted, untrimmed reads) plus
        // MultiQC remain. The narrowest possible real analysis this entry
        // point can express.
        when {
            params {
                outdir             = "$outputDir"
                skip_fastp         = true
                skip_fastqc        = true
                skip_host_removal  = true
                skip_megahit       = true
                skip_kraken2       = false
                kraken2_db         = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
                skip_quast         = true
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/fastp").exists()
            assert !path("${outputDir}/fastqc").exists()
            assert !path("${outputDir}/bowtie2").exists()
            assert !path("${outputDir}/megahit").exists()
            assert !path("${outputDir}/quast").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").text.trim().length() > 0
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }

    test("fastq: geNomad + CheckV find and grade the real virus in the toy fixture") {
        tag "requires_db"

        // The toy fixture is a genuine SARS-CoV-2 genome fragment (nf-core's
        // own sarscov2 test-datasets), so this isn't a mechanics-only check
        // the way the tiny Kraken2 viral-DB test above is - geNomad is
        // expected to actually find and correctly taxonomically classify
        // real viral sequence here, verified 2026-09-12: 7 contigs
        // consistently come back tagged down to family level
        // (Coronaviridae), and CheckV grades them Low-quality genome
        // fragments (correct - each is a few hundred bp of a ~30kb genome)
        // with zero contamination. Needs `bin/download-dbs.sh genomad` and
        // `bin/download-dbs.sh checkv` run first (real DBs, ~5GB/~1.6GB) -
        // same "not part of the zero-setup basic suite" reasoning as
        // Kraken2's requires_db tests. Also needs the scoped
        // `resourceLimits` override on GENOMAD_ENDTOEND in conf/test.config
        // - found the hard way 2026-09-12 that geNomad's mmseqs2 marker
        // search SIGKILLs under the profile's general 6GB cap even with
        // --splits applied (conf/modules.config); a `withName`-scoped
        // override raises the ceiling only for this one process rather than
        // eroding the general cap's guarantee of working on weaker dev
        // machines (PLAN.md §1.1).
        when {
            params {
                outdir       = "$outputDir"
                skip_genomad = false
                genomad_db   = "${System.getenv('HOME')}/microbox-dbs/genomad/genomad_db"
                skip_checkv  = false
                checkv_db    = "${System.getenv('HOME')}/microbox-dbs/checkv/checkv-db-v1.5"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/genomad/test/test.contigs_summary/test.contigs_virus_summary.tsv").text.contains("Coronaviridae")
            assert path("${outputDir}/checkv/test/quality_summary.tsv").text.contains("checkv_quality")
            assert path("${outputDir}/pipeline_info/genomad_summary_mqc.yml").text.contains("n_viruses")
            assert path("${outputDir}/pipeline_info/checkv_summary_mqc.yml").text.contains("n_viruses_assessed")
        }
    }

    test("fastq: skip_maxbin2=false bins the assembly into per-organism clusters (real bacterial fixture)") {
        tag "basic"

        // Needs a DIFFERENT samplesheet than every other "basic" test here:
        // this project's shared toy fixture is a real SARS-CoV-2 (viral)
        // genome fragment, which is exactly wrong for MaxBin2 - verified the
        // hard way 2026-09-13, running the real container directly outside
        // Nextflow first: MaxBin2's internal marker-gene step (FragGeneScan,
        // which expects bacterial-style ORFs) crashes outright on it
        // ("Error running FragGeneScan... make sure you are running
        // FragGeneScan 1.18 or above"), unrelated to this pipeline's own
        // wiring. nf-core's own maxbin2 module test uses a small real
        // bacterial fixture for exactly this reason (bacteroides_fragilis,
        // nf-core/test-datasets) - reused here rather than inventing a new
        // one, confirmed reachable (HTTP 200) and confirmed end-to-end
        // (fresh MEGAHIT assembly of these exact reads -> MaxBin2 binning,
        // both run manually outside Nextflow first) before writing this
        // test, matching this project's "verify real behavior, don't guess"
        // standard.
        when {
            params {
                outdir       = "$outputDir"
                input        = "${projectDir}/assets/samplesheet_maxbin2_test.csv"
                skip_maxbin2 = false
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/maxbin2/bfrag.summary").exists()
            // Real content, not just "the file exists" (this project's own
            // established rule, Fixed #13/#15) - MaxBin2's summary is a
            // tab-separated Bin name/Completeness/Genome size/GC content
            // table; asserting the header proves this is a genuine MaxBin2
            // summary, not an empty or truncated file.
            assert path("${outputDir}/maxbin2/bfrag.summary").text.contains("Completeness")
            assert path("${outputDir}/maxbin2/bfrag.001.fasta.gz").exists()
            assert path("${outputDir}/pipeline_info/maxbin2_summary_mqc.yml").text.contains("n_bins")
        }
    }

    // ============================================================
    // input_type=contigs (second entry point, PLAN.md §6.7) - also
    // zero external setup: everything upstream of contigs (QC,
    // depletion, assembly) simply doesn't run, not "runs and gets
    // skipped" - there's nothing to feed it.
    // ============================================================

    test("contigs: defaults - skips straight to QUAST, no read-based stages run at all") {
        tag "basic"

        when {
            params {
                outdir     = "$outputDir"
                input_type = "contigs"
                input      = "${projectDir}/assets/samplesheet_test_contigs.csv"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/fastp").exists()
            assert !path("${outputDir}/fastqc").exists()
            assert !path("${outputDir}/bowtie2").exists()
            assert !path("${outputDir}/megahit").exists()
            assert path("${outputDir}/quast/test.tsv").exists()
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
        }
    }

    test("contigs: skip_quast=true - nothing left to analyze, fails with a clear message (not a MultiQC crash)") {
        tag "basic"

        // Real degenerate case, not hypothetical: contigs input + QUAST off
        // + Kraken2 off (its default) leaves genuinely nothing to run.
        // workflows/microbox.nf catches this explicitly (.ifEmpty{ error
        // "..." }) rather than letting it reach MultiQC and fail with
        // MultiQC's own opaque "no analysis results found" - this test
        // exists to make sure that guard stays in place, not to prove the
        // pipeline "succeeds" doing nothing.
        when {
            params {
                outdir     = "$outputDir"
                input_type = "contigs"
                input      = "${projectDir}/assets/samplesheet_test_contigs.csv"
                skip_quast = true
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.toString().contains("Nothing enabled to analyze or report")
        }
    }

    // ============================================================
    // Requires bin/download-dbs.sh viral to have been run first (the DB is
    // a whole directory nf-test/Nextflow can't fetch on its own). Run
    // explicitly with: nf-test test --tag requires_db
    // ============================================================

    test("fastq: Kraken2+Bracken classify the depleted reads when explicitly enabled") {
        tag "requires_db"

        when {
            params {
                outdir       = "$outputDir"
                skip_kraken2 = false
                kraken2_db   = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert path("${outputDir}/bracken/test.tsv").exists()
        }
    }

    test("fastq: Kraken2 enabled but skip_bracken=true - classification without re-estimation") {
        tag "requires_db"

        when {
            params {
                outdir       = "$outputDir"
                skip_kraken2 = false
                skip_bracken = true
                kraken2_db   = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert !path("${outputDir}/bracken").exists()
        }
    }

    test("fastq: skip_host_removal AND Kraken2 together - classifies undepleted reads correctly") {
        tag "requires_db"

        when {
            params {
                outdir            = "$outputDir"
                skip_host_removal = true
                skip_kraken2      = false
                kraken2_db        = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
        }
    }

    test("contigs: Kraken2 classifies contigs directly (not reads) when enabled; Bracken auto-skips") {
        tag "requires_db"

        // Bracken defaults to ON (skip_bracken=false) but must NOT run here -
        // confirmed the hard way that it crashes on contigs (its kmer_distrib
        // files assume ~100bp reads, not whole assembled sequences), so
        // workflows/microbox.nf force-skips it for input_type=contigs
        // regardless of the flag. This test exists to make sure that guard
        // stays in place.
        when {
            params {
                outdir       = "$outputDir"
                input_type   = "contigs"
                input        = "${projectDir}/assets/samplesheet_test_contigs.csv"
                skip_kraken2 = false
                kraken2_db   = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            // Not just "the file exists" - docs/KNOWN_ISSUES.md #15: a real
            // bug (uncompressed contigs silently gzip-decompress-failing
            // inside kraken2, --gzip-compressed being unconditional in the
            // vendored module) produced an empty-but-existing report here,
            // undetected until a single-node run isolated it. Same class of
            // "file exists on disk != real data reached the pipeline" gap
            // as #13 (QUAST/MultiQC). Guard against regressing.
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").text.trim().length() > 0
            assert !path("${outputDir}/bracken").exists()
        }
    }

    // ============================================================
    // A SECOND, independent Kraken2 classification pass - added 2026-09-13
    // at the owner's request, matching a real reference pipeline diagram
    // their R&D team provided (FastQC's reads feed Kraken2 directly, as
    // well as - separately, optionally - Bowtie2's depleted reads). See
    // workflows/microbox.nf's params.skip_kraken2_predepletion block.
    // ============================================================

    test("fastq: pre-depletion Kraken2+Bracken classify the trimmed reads (before host removal) when explicitly enabled") {
        tag "requires_db"

        when {
            params {
                outdir                    = "$outputDir"
                skip_kraken2_predepletion = false
                kraken2_db                = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/kraken2_predepletion/test_predepletion.kraken2.report.txt").exists()
            assert path("${outputDir}/bracken_predepletion/test_predepletion.tsv").exists()
            // The post-depletion pass (skip_kraken2, default true) must
            // stay off - these two flags are genuinely independent.
            assert !path("${outputDir}/kraken2").exists()
            assert !path("${outputDir}/bracken").exists()
        }
    }

    test("fastq: both Kraken2 passes enabled together produce two distinct, non-colliding reports") {
        tag "requires_db"

        when {
            params {
                outdir                    = "$outputDir"
                skip_kraken2              = false
                skip_kraken2_predepletion = false
                kraken2_db                = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            // Both classifications ran on the SAME sample (same meta.id) -
            // ext.prefix on the predepletion pass (conf/modules.config)
            // must keep their filenames from colliding, or one would
            // silently overwrite the other on disk / in MultiQC.
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert path("${outputDir}/kraken2_predepletion/test_predepletion.kraken2.report.txt").exists()
            assert path("${outputDir}/bracken/test.tsv").exists()
            assert path("${outputDir}/bracken_predepletion/test_predepletion.tsv").exists()
        }
    }

    test("fastq: pre-depletion Kraken2 enabled but skip_bracken=true - classification without re-estimation") {
        tag "requires_db"

        when {
            params {
                outdir                    = "$outputDir"
                skip_kraken2_predepletion = false
                skip_bracken              = true
                kraken2_db                = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/kraken2_predepletion/test_predepletion.kraken2.report.txt").exists()
            assert !path("${outputDir}/bracken_predepletion").exists()
        }
    }

    test("contigs: pre-depletion Kraken2 is inapplicable and auto-skips (no pre-depletion reads exist there)") {
        tag "requires_db"

        // Mirrors the existing skip_host_removal-on-contigs guard pattern -
        // there is nothing before assembly on the contigs entry point, so
        // this must not crash or silently misbehave, just log and skip.
        when {
            params {
                outdir                    = "$outputDir"
                input_type                = "contigs"
                input                     = "${projectDir}/assets/samplesheet_test_contigs.csv"
                skip_kraken2_predepletion = false
                kraken2_db                = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/kraken2_predepletion").exists()
        }
    }

    // ============================================================
    // Toolbox combinatorics sweep (owner, 2026-09-11): "how many unique
    // combinations are possible, and does a single-node pipeline (e.g.
    // Kraken2 alone) actually work?" The engine is a fixed backbone with 4
    // independent toggles (skip_host_removal, skip_kraken2, skip_bracken,
    // skip_quast) rather than a freely-reorderable graph (§6.10 Option A) -
    // FASTP/FASTQC/MEGAHIT have no skip_* flag and always run for
    // input_type=fastq. That makes the behaviorally-distinct space small
    // and enumerable: 12 fastq-entry configurations + 4 contigs-entry
    // configurations = 16 total. Everything above already covers 10 of
    // those 16 (6 basic + 4 requires_db). These 6 fill the remaining gap -
    // including the one the toolbox model explicitly promises must work:
    // a single-tool pipeline (Kraken2 alone, nothing upstream or
    // downstream but MultiQC).
    // ============================================================

    test("fastq: host removal + Kraken2 + Bracken, QUAST off - assembly branch fully idle") {
        tag "requires_db"

        when {
            params {
                outdir       = "$outputDir"
                skip_kraken2 = false
                skip_quast   = true
                kraken2_db   = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert path("${outputDir}/bracken/test.tsv").exists()
            assert !path("${outputDir}/quast").exists()
            // MEGAHIT itself is NOT independently skippable (no skip_megahit
            // flag exists) - it always runs for input_type=fastq regardless
            // of skip_quast, so its output must still be present even though
            // nothing consumes it for reporting.
            assert path("${outputDir}/megahit/test.contigs.fa.gz").exists()
        }
    }

    test("fastq: host removal + Kraken2 only (Bracken and QUAST both off) - narrowest fastq-entry classification run") {
        tag "requires_db"

        when {
            params {
                outdir       = "$outputDir"
                skip_kraken2 = false
                skip_bracken = true
                skip_quast   = true
                kraken2_db   = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert !path("${outputDir}/bracken").exists()
            assert !path("${outputDir}/quast").exists()
        }
    }

    test("fastq: no host removal, Kraken2 + Bracken, QUAST off") {
        tag "requires_db"

        when {
            params {
                outdir            = "$outputDir"
                skip_host_removal = true
                skip_kraken2      = false
                skip_quast        = true
                kraken2_db        = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert path("${outputDir}/bracken/test.tsv").exists()
            assert !path("${outputDir}/quast").exists()
        }
    }

    test("fastq: no host removal, Kraken2 without Bracken, QUAST on") {
        tag "requires_db"

        when {
            params {
                outdir            = "$outputDir"
                skip_host_removal = true
                skip_kraken2      = false
                skip_bracken      = true
                kraken2_db        = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert !path("${outputDir}/bracken").exists()
            assert path("${outputDir}/quast/test.tsv").exists()
        }
    }

    test("fastq: no host removal, Kraken2 without Bracken, QUAST off - narrowest possible fastq-entry run") {
        tag "requires_db"

        // The minimum footprint reachable from a raw-FASTQ entry point:
        // FASTP/FASTQC/MEGAHIT still run (no flag skips them - they are not
        // optional for this entry type), but every genuinely optional stage
        // is off except classification itself.
        when {
            params {
                outdir            = "$outputDir"
                skip_host_removal = true
                skip_kraken2      = false
                skip_bracken      = true
                skip_quast        = true
                kraken2_db        = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/bowtie2").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert !path("${outputDir}/bracken").exists()
            assert !path("${outputDir}/quast").exists()
        }
    }

    test("contigs: Kraken2 alone - the genuine single-node pipeline (owner's example, previously untested)") {
        tag "requires_db"

        // This is the smallest real analysis pipeline the toolbox can
        // express today: one tool (Kraken2), nothing upstream (contigs
        // entry skips fastp/FastQC/Bowtie2/MEGAHIT entirely - not just
        // "skipped", genuinely inapplicable, §6.7), nothing downstream but
        // MultiQC's aggregation. Bracken is force-skipped for contigs
        // regardless of skip_bracken (it would crash - docs/KNOWN_ISSUES.md
        // #14), so this is really testing whether Kraken2's report alone,
        // with QUAST fully off, still produces a valid MultiQC report
        // rather than repeating the "QUAST-only" silent-drop class of bug
        // (docs/KNOWN_ISSUES.md #13) for Kraken2 specifically.
        when {
            params {
                outdir       = "$outputDir"
                input_type   = "contigs"
                input        = "${projectDir}/assets/samplesheet_test_contigs.csv"
                skip_kraken2 = false
                skip_quast   = true
                kraken2_db   = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert !path("${outputDir}/fastp").exists()
            assert !path("${outputDir}/fastqc").exists()
            assert !path("${outputDir}/bowtie2").exists()
            assert !path("${outputDir}/megahit").exists()
            assert !path("${outputDir}/quast").exists()
            assert !path("${outputDir}/bracken").exists()
            assert path("${outputDir}/kraken2/test.kraken2.report.txt").exists()
            assert path("${outputDir}/multiqc/multiqc_report.html").exists()
            // Same class of bug as docs/KNOWN_ISSUES.md #13 (QUAST's data
            // silently absent from MultiQC) - verify Kraken2's data actually
            // reached the aggregated report content, not just that its own
            // output file exists on disk next to an empty-looking MultiQC
            // report.
            assert path("${outputDir}/multiqc/multiqc_data/multiqc_general_stats.txt").text.contains("kraken")
        }
    }

    // ============================================================
    // pipeline=wgs (pathogen/isolate WGS sibling pipeline, PLAN.md §6.9)
    // ============================================================
    // Runs under this file's normal --profile test,docker invocation, NOT a
    // separate nf-test invocation - pipeline/input are overridden directly
    // in each test's own params block, the same convention the "contigs"
    // tests above use for their own non-default input_type/input.
    // conf/test_wgs.config exists separately for direct manual runs (e.g.
    // `bin/run.sh --pipeline wgs -profile test_wgs,docker`), not for this
    // shared test file.

    test("wgs: defaults - nothing enabled yet, fails with a clear message (not a MultiQC crash)") {
        tag "basic"

        // Phase 1's original skeleton always tried to produce a green
        // MultiQC report even with zero tools enabled - a real bug, not a
        // style choice (see workflows/wgs.nf's own comment and
        // docs/KNOWN_ISSUES.md #22: MultiQC itself exits 0 with no report
        // at all when given nothing to genuinely aggregate). This is the
        // same degenerate-case guard workflows/microbox.nf already has
        // (its own "everything optional off" test above), now proven for
        // the WGS pipeline too - honest about what actually works today
        // (skip_bwamem2 defaults true, and it's still the only stage) not
        // a placeholder pretending more exists.
        //
        // Deliberately reuses the tiny existing SARS-CoV-2 fixture
        // (~9.4KB, not assets/samplesheet_wgs_test.csv's real ~115MB
        // S. aureus dataset below) - this test never reads the fastqs at
        // all, it only exercises the "nothing enabled" guard, so the
        // smallest available real fixture is the right choice here
        // specifically, independent of what the positive test needs.
        when {
            params {
                outdir   = "$outputDir"
                pipeline = "wgs"
                input    = "${projectDir}/assets/samplesheet_test.csv"
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.toString().contains("Nothing enabled to analyze or report")
        }
    }

    test("wgs: skip_bwamem2=false - reference-guided alignment produces a real BAM and real MultiQC content") {
        tag "basic"

        // Real biological validation, not just mechanics - corrected
        // 2026-09-14 after being challenged on an earlier, unverified "too
        // large" dismissal of this exact dataset. assets/
        // samplesheet_wgs_test.csv is nf-core/bacass's own real test
        // fixture (ERR044595, ~115MB total for R1+R2) - actually measured,
        // not assumed: downloads in ~19s, BWA-MEM2 indexes a real bacterial
        // reference in <1s and aligns all 1M read pairs in ~20-23s on this
        // profile's 2cpu/6GB ceiling, comparable to or faster than several
        // other tests already in this suite (e.g. the MaxBin2 test above
        // takes ~80s). ERR044595 is real ENA-cataloged Staphylococcus
        // aureus sequencing data (confirmed via ENA's own portal API, not
        // guessed) - NC_007795.1 (S. aureus NCTC 8325) is the matching
        // reference, and a real run against it maps ~90.7% of reads, not
        // the ~0.15% an unrelated reference would give - genuine evidence
        // this is the right organism, not just a plausible-looking file.
        when {
            params {
                outdir              = "$outputDir"
                pipeline            = "wgs"
                input               = "${projectDir}/assets/samplesheet_wgs_test.csv"
                skip_bwamem2        = false
                wgs_reference_fasta = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NC_007795.1&rettype=fasta&retmode=text"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/wgs/bwamem2/index").exists()
            assert path("${outputDir}/wgs/bwamem2/align/ERR044595.bam").exists()
            assert path("${outputDir}/wgs/bwamem2/align/ERR044595.bam.csi").exists()
            // Real content, not just existence (this repo's own hard rule,
            // docs/TESTING.md/CONTRIBUTING.md) - samtools stats' own output
            // format, AND the real measured mapping rate for this exact
            // organism/reference pair (90.7%, not some other number) -
            // confirms this is genuinely the right reference, not just any
            // reference that happens to produce a file.
            assert path("${outputDir}/wgs/samtools_stats/ERR044595.stats").text.contains("SN\traw total sequences:")
            assert path("${outputDir}/wgs/samtools_stats/ERR044595.stats").text.contains("error rate:")
            assert path("${outputDir}/wgs/multiqc/multiqc_report.html").exists()
            // Same class of bug as docs/KNOWN_ISSUES.md #13/#22 (data
            // silently absent from MultiQC despite the source file existing
            // on disk) - verify samtools stats' data actually reached the
            // aggregated report content, not just that the .stats file
            // exists next to an empty-looking MultiQC report.
            assert path("${outputDir}/wgs/multiqc/multiqc_data/multiqc_general_stats.txt").text.toLowerCase().contains("err044595")
            assert path("${outputDir}/pipeline_info/software_versions.yml").text.contains("bwamem2")
            assert path("${outputDir}/pipeline_info/software_versions.yml").text.contains("samtools")
        }
    }

    // Phase 3: pre-flight species/contamination screening (PLAN.md §6.9).
    // Both Kraken2-WGS and Mash need a real pre-downloaded external DB not
    // fetched by the zero-setup test profile - tagged requires_db, same
    // convention as the existing "contigs: Kraken2 alone" test above, run
    // manually (bin/download-dbs.sh viral / mash_refseq first), not in CI.
    // seqkit/stats needs no DB and is tagged basic.

    test("wgs: skip_kraken2_wgs=false - real species/contamination classification against a real DB") {
        tag "requires_db"

        // Real observed content, not an assumed value: the viral-only
        // Kraken2 DB (this repo's existing basic dev-tier DB) genuinely
        // cannot classify real bacterial (S. aureus) reads - 96.07%
        // unclassified is the actual, correct result for this DB/organism
        // pairing, run once during implementation to see what it really
        // reports (2026-09-14), not fabricated as "should classify".
        // Proves the code path genuinely runs and reports reality, the
        // same honesty standard as every other real-content assertion in
        // this suite - a DB/organism mismatch is itself a valid, correctly
        // reported result, not a test failure to paper over.
        when {
            params {
                outdir           = "$outputDir"
                pipeline         = "wgs"
                input            = "${projectDir}/assets/samplesheet_wgs_test.csv"
                skip_kraken2_wgs = false
                kraken2_db       = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/wgs/kraken2/ERR044595.kraken2.report.txt").text.contains("unclassified")
            assert path("${outputDir}/wgs/multiqc/multiqc_data/multiqc_general_stats.txt").text.contains("kraken")
        }
    }

    test("wgs: skip_mash=false - real species confirmation against the real RefSeq sketch DB") {
        tag "requires_db"

        // Real observed content: screening ERR044595 (real S. aureus reads)
        // against the real external RefSeq sketch DB (bin/download-dbs.sh
        // mash_refseq) correctly identifies GCF_000284535.1 Staphylococcus
        // aureus subsp. aureus HO 5096 0412 as a perfect match (identity 1,
        // 1000/1000 shared hashes) - verified by actually running it
        // 2026-09-14, not assumed. Genuine species confirmation, the actual
        // point of this pre-flight stage.
        when {
            params {
                outdir         = "$outputDir"
                pipeline       = "wgs"
                input          = "${projectDir}/assets/samplesheet_wgs_test.csv"
                skip_mash      = false
                mash_refseq_db = "${System.getenv('HOME')}/microbox-dbs/mash/refseq.genomes.k21s1000.msh"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/wgs/mash/ERR044595.screen").text.contains("Staphylococcus aureus")
            // Mash has no native MultiQC module, but real bug found and
            // fixed while writing this test (see workflows/wgs.nf's own
            // comment): a first version left Mash with zero MultiQC
            // contribution, which meant a skip_mash=false-only run hit the
            // "Nothing enabled" guard despite genuinely running - fixed
            // with a real custom-content summary, asserted here.
            assert path("${outputDir}/wgs/mash/mash_screen_mqc.yml").text.contains("Staphylococcus aureus")
            assert path("${outputDir}/wgs/multiqc/multiqc_report.html").exists()
        }
    }

    test("wgs: skip_seqkit_stats=false - real read stats reach MultiQC, no DB needed") {
        tag "basic"

        when {
            params {
                outdir            = "$outputDir"
                pipeline          = "wgs"
                input             = "${projectDir}/assets/samplesheet_wgs_test.csv"
                skip_seqkit_stats = false
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/wgs/seqkit_stats/ERR044595.tsv").text.contains("num_seqs")
            // Same class of bug as docs/KNOWN_ISSUES.md #13/#22/#23 (data
            // silently absent from MultiQC despite the source file existing
            // on disk) - verify seqkit's real per-file stats actually
            // reached the aggregated report content.
            assert path("${outputDir}/wgs/multiqc/multiqc_data/multiqc_general_stats.txt").text.contains("seqkit")
        }
    }

    // Phase 4: variant calling (GATK4 HaplotypeCaller, PLAN.md §6.9). Always
    // GVCF mode (-ERC GVCF) then per-sample GenotypeGVCFs - real bugs found
    // and fixed while wiring this, not assumed safe: (a) GATK4 requires a
    // recognized fasta extension on the staged reference filename, which an
    // NCBI-efetch-URL-sourced reference doesn't have - fixed with a new
    // local RENAME_REFERENCE module; (b) BWA-MEM2 emits no @RG line by
    // default, and GVCF mode refuses to run without one identifying a
    // single sample - fixed via a real read-group ext.args; (c) a real,
    // serious data-corruption bug where GATK4_HAPLOTYPECALLER and
    // GATK4_GENOTYPEGVCFS defaulted to the SAME output filename, and
    // GenotypeGVCFs writing through its own same-named input symlink
    // genuinely emptied the real GVCF (confirmed directly: HaplotypeCaller's
    // own log showed it processed all 20,331 regions across the whole
    // genome, but the file on disk ended up containing GenotypeGVCFs'
    // near-empty output instead) - fixed with a distinct ext.prefix, same
    // class of fix as this repo's existing KRAKEN2_KRAKEN2_PREDEPLETION
    // collision fix.

    test("wgs: skip_gatk4=false - real variant calling produces a real called variant") {
        tag "basic"

        // Real observed content, not assumed: NC_007795.1:89 C>T is a real
        // homozygous variant GATK4 actually calls from ERR044595 vs this
        // reference (verified by actually running it 2026-09-14, not
        // predicted) - genuine evidence the whole chain (alignment -> GVCF
        // -> genotyping) produces correct, usable output, not just files
        // that exist. Slower than this suite's other tests (~4-5 minutes,
        // mostly HaplotypeCaller's own real per-base computation across a
        // ~2.86 Mb genome) but still self-contained - no external DB, same
        // reasoning that keeps it `basic` rather than `requires_db`.
        when {
            params {
                outdir              = "$outputDir"
                pipeline            = "wgs"
                input               = "${projectDir}/assets/samplesheet_wgs_test.csv"
                skip_bwamem2        = false
                skip_gatk4          = false
                wgs_reference_fasta = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NC_007795.1&rettype=fasta&retmode=text"
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/wgs/gatk4/reference").exists()
            assert path("${outputDir}/wgs/gatk4/haplotypecaller/ERR044595.g.vcf.gz").exists()
            assert path("${outputDir}/wgs/gatk4/genotypegvcfs/ERR044595.vcf.gz").exists()
            // Real content - a specific real variant call, not just file
            // existence (this repo's own hard rule) - unzip and check for
            // the actual observed C>T call at position 89. Plain
            // java.util.zip rather than an unverified nf-test path helper -
            // this repo has no prior precedent reading gzip content in a
            // test, so using a guaranteed-real API instead of guessing one.
            def vcfText = new java.util.zip.GZIPInputStream(
                new File("${outputDir}/wgs/gatk4/genotypegvcfs/ERR044595.vcf.gz").newInputStream()
            ).text
            assert vcfText.readLines().any { it.startsWith("NC_007795.1\t89\t") && it.contains("\tC\tT\t") }
        }
    }

    test("wgs: skip_gatk4=false with skip_bwamem2=true - inapplicable combination auto-skips with a warning, not a crash") {
        tag "basic"

        // Same "warn, don't crash" guard convention as every other
        // inapplicable-combination test in this suite (e.g. the metagenomics
        // skip_megahit+skip_quast test above) - GATK4 has nothing to call
        // variants from without BWA-MEM2's own BAM, and with every other
        // WGS stage also at its default (skip), this correctly still hits
        // the "Nothing enabled" guard, not a silent no-op.
        when {
            params {
                outdir       = "$outputDir"
                pipeline     = "wgs"
                input        = "${projectDir}/assets/samplesheet_test.csv"
                skip_bwamem2 = true
                skip_gatk4   = false
            }
        }

        then {
            assert !workflow.success
            // NOT asserting on "Auto-skipping GATK4" text here - real
            // finding, not assumed: `log.warn` routes through Nextflow's
            // own logger (confirmed present in the run's .nextflow.log),
            // not the plain `workflow.stdout` stream nf-test exposes (which
            // only carries the script's own error()/println output). The
            // warning firing is a real, secondary effect verified manually
            // once; the guard's actually-observable behavior - the run
            // still correctly fails with "Nothing enabled" rather than
            // silently succeeding on an inapplicable combination - is what
            // this assertion checks, since that's what's actually visible
            // on the interface nf-test can see.
            assert workflow.stdout.toString().contains("Nothing enabled to analyze or report")
        }
    }

    // Phase 5: full assembly - every WGS stage enabled together for the
    // first time (each was previously tested only individually/pairwise).
    // Real interaction risk this closes: multiple real MultiQC contributions
    // (Kraken2's native module, Mash's custom summary, seqkit's native
    // module, samtools stats' native module) mixing into one report
    // correctly, and the full pre-flight -> alignment -> variant-calling
    // chain not interfering with itself when run as one pipeline instead of
    // isolated single-stage runs. Verified once manually before writing this
    // (2026-09-14): all 12 tasks succeeded in 5m44s, and every stage's real
    // result was independently confirmed present and unchanged from its own
    // isolated test (same 37,491 variants, same Mash top hit, same 96.07%
    // Kraken2-unclassified, same real per-tool versions) - genuinely
    // combining cleanly, not just each running in isolation by accident.
    test("wgs: everything enabled together - full pipeline produces real, correctly combined results") {
        tag "requires_db"

        when {
            params {
                outdir              = "$outputDir"
                pipeline            = "wgs"
                input               = "${projectDir}/assets/samplesheet_wgs_test.csv"
                skip_kraken2_wgs    = false
                skip_mash           = false
                skip_seqkit_stats   = false
                skip_bwamem2        = false
                skip_gatk4          = false
                kraken2_db          = "${System.getenv('HOME')}/microbox-dbs/kraken2/viral"
                mash_refseq_db      = "${System.getenv('HOME')}/microbox-dbs/mash/refseq.genomes.k21s1000.msh"
                wgs_reference_fasta = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=NC_007795.1&rettype=fasta&retmode=text"
            }
        }

        then {
            assert workflow.success
            // Real content per stage, not just file existence - each
            // checked against the exact real value already confirmed by
            // that stage's own isolated test, proving nothing shifted when
            // run together.
            assert path("${outputDir}/wgs/kraken2/ERR044595.kraken2.report.txt").text.contains("unclassified")
            assert path("${outputDir}/wgs/mash/ERR044595.screen").text.contains("Staphylococcus aureus")
            assert path("${outputDir}/wgs/mash/mash_screen_mqc.yml").text.contains("Staphylococcus aureus")
            assert path("${outputDir}/wgs/seqkit_stats/ERR044595.tsv").text.contains("num_seqs")
            assert path("${outputDir}/wgs/bwamem2/align/ERR044595.bam").exists()
            def vcfText = new java.util.zip.GZIPInputStream(
                new File("${outputDir}/wgs/gatk4/genotypegvcfs/ERR044595.vcf.gz").newInputStream()
            ).text
            assert vcfText.readLines().any { it.startsWith("NC_007795.1\t89\t") && it.contains("\tC\tT\t") }
            // Real, combined MultiQC report - every tool's data reached the
            // SAME aggregated report together, not four separate reports.
            def generalStats = path("${outputDir}/wgs/multiqc/multiqc_data/multiqc_general_stats.txt").text
            assert generalStats.contains("seqkit")
            assert generalStats.contains("samtools_stats")
            assert generalStats.contains("kraken")
            // Real, complete tool-version provenance across every stage -
            // proves each tool's own versions-topic emission survived being
            // mixed together, not just the last one to run.
            def versionsText = path("${outputDir}/pipeline_info/software_versions.yml").text
            assert versionsText.contains("bwamem2")
            assert versionsText.contains("kraken2")
            assert versionsText.contains("mash")
            assert versionsText.contains("seqkit")
            assert versionsText.contains("gatk4")
        }
    }

}
